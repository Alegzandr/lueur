{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lueur",
  "identifier": "com.lueur.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lueur",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Low-latency ambilight for smart bulbs.",
    "longDescription": "Lueur turns your smart bulbs into a low-latency ambilight for cosy night gaming. Draw your room, place your screen and lights, pick your bulbs, and the light around you follows what's on screen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5N0NBMTkxRTY1QTA0MTIKUldRU0JGcm1rYUY4ZVc0YkxHeS9xcGNURWlBYkE1bVJtSWVtbFFSenkvSTVld1d2QlNvZmthQlYK",
      "endpoints": [
        "https://github.com/Alegzandr/lueur/releases/latest/download/latest.json"
      ]
    }
  }
}
